COMPOSE_PROJECT_NAME=homelab
TZ=Europe/Warsaw
PUID=1000
PGID=1000
HOST_FQDN=cubi.michalklos.com
HOST_LAN_IP=192.168.10.10
HOST_GATEWAY=192.168.10.1
HOST_DNS=192.168.10.1
LOCAL_DNS_ZONE=michalklos.com
DATA_ROOT=/srv
APPDATA_ROOT=/srv/homelab
# Jellyfin library + qBittorrent/*arr downloads live on external HDD (mounted via fstab).
MEDIA_ROOT=/mnt/media
# Immich stays on the SSD (separate from MEDIA_ROOT so it isn't moved to the HDD).
IMMICH_LIBRARY_ROOT=/srv/data/immich/library
BACKUP_MOUNT_POINT=/mnt/backup-usb
RESTIC_REPOSITORY=/mnt/backup-usb/restic
RESTIC_PASSWORD=CHANGE_ME_LONG_RANDOM
RESTIC_RETENTION_WEEKLY=8
RESTIC_RETENTION_MONTHLY=6
CF_DNS_API_TOKEN=CHANGE_ME
ACME_EMAIL=CHANGE_ME

TRAEFIK_HOST=traefik.michalklos.com
ADGUARD_HOST=dns.michalklos.com
HOMEPAGE_HOST=home.michalklos.com
IMMICH_HOST=immich.michalklos.com
JELLYFIN_HOST=jellyfin.michalklos.com
HOMEASSISTANT_HOST=ha.michalklos.com
DOZZLE_HOST=logs.michalklos.com
PORTAINER_HOST=portainer.michalklos.com
STIRLING_HOST=pdf.michalklos.com
FILEBROWSER_HOST=files.michalklos.com
SEERR_HOST=seerr.michalklos.com
RADARR_HOST=radarr.michalklos.com
SONARR_HOST=sonarr.michalklos.com
PROWLARR_HOST=prowlarr.michalklos.com
BAZARR_HOST=bazarr.michalklos.com
QBITTORRENT_HOST=qbit.michalklos.com

IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=CHANGE_ME
JELLYFIN_PUBLISHED_SERVER_URL=https://jellyfin.michalklos.com
TAILSCALE_AUTHKEY=
SAMBA_USERNAME=samba
SAMBA_PASSWORD=CHANGE_ME

NORDVPN_PRIVATE_KEY=CHANGE_ME


# Homepage dashboard widgets — consumed by the homepage container as HOMEPAGE_VAR_*.
# Grab API keys from each service's settings page after first-time setup.
ADGUARD_USERNAME=CHANGE_ME
ADGUARD_PASSWORD=CHANGE_ME
IMMICH_API_KEY=CHANGE_ME
JELLYFIN_API_KEY=CHANGE_ME
HOMEASSISTANT_TOKEN=CHANGE_ME
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=CHANGE_ME
SEERR_API_KEY=CHANGE_ME
PROWLARR_API_KEY=CHANGE_ME
RADARR_API_KEY=CHANGE_ME
SONARR_API_KEY=CHANGE_ME
BAZARR_API_KEY=CHANGE_ME
PORTAINER_API_KEY=CHANGE_ME