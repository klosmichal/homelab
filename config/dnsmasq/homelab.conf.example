# basic security and behavior
domain-needed
bogus-priv
expand-hosts

# local domain and listen address
local=/home.arpa/
domain=home.arpa
listen-address=127.0.0.1,192.168.10.10
bind-interfaces

# cache size
cache-size=1000

# don't read resolvers and hosts from the system (/etc/resolv.conf and /etc/hosts)
no-resolv
no-hosts

# upstream DNS servers
server=1.1.1.1
server=1.0.0.1

# A records for local services
address=/cubi.home.arpa/192.168.10.10
address=/traefik.home.arpa/192.168.10.10
address=/home.home.arpa/192.168.10.10
address=/immich.home.arpa/192.168.10.10
address=/jellyfin.home.arpa/192.168.10.10
address=/vault.home.arpa/192.168.10.10
address=/ha.home.arpa/192.168.10.10
address=/portainer.home.arpa/192.168.10.10
address=/logs.home.arpa/192.168.10.10
address=/kuma.home.arpa/192.168.10.10
address=/pdf.home.arpa/192.168.10.10
